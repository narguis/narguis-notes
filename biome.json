{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/.codegraph",
      "!**/.omo",
      "!**/node_modules",
      "!**/dist",
      "!**/playwright-report",
      "!**/src-tauri/gen",
      "!**/src-tauri/target",
      "!**/test-results",
      "!**/.vite",
      "!**/coverage"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      },
      "complexity": {
        "useLiteralKeys": "off"
      },
      "style": {
        "noDefaultExport": "error",
        "noNonNullAssertion": "error",
        "useImportType": "error",
        "noParameterAssign": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["*.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded"
    }
  }
}
