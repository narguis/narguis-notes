{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Allowlisted Notes Planner application commands for the main window.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-local-today",
    "allow-get-daily-page",
    "allow-save-daily-page",
    "allow-list-notes",
    "allow-create-note",
    "allow-update-note",
    "allow-delete-note",
    "allow-list-planner-lines",
    "allow-create-planner-line",
    "allow-update-planner-line",
    "allow-delete-planner-line",
    "allow-move-planner-line",
    "allow-set-planner-line-collapsed",
    "allow-set-planner-line-time",
    "allow-list-task-templates",
    "allow-create-task-template",
    "allow-update-task-template",
    "allow-delete-task-template",
    "allow-insert-task-template-copy"
  ]
}
